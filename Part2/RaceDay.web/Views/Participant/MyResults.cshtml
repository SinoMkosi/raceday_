@model List<RaceDay.Web.Models.MyResultItem>
@{
    ViewData["Title"] = "My results";
}

<h2 class="mb-3">My results</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model.Count == 0)
{
    <p>You have no results yet. Results show here after an organiser captures them for an event you enrolled in.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Finish time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.EventName</td>
                        <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@r.CategoryName</td>
                        <td>@r.FinishTime.ToString(@"hh\:mm\:ss")</td>
                        <td><strong>@r.PositionText</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}