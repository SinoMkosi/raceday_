@model RaceDay.Web.Models.ResultsPageViewModel
@{
    ViewData["Title"] = "Results";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Results: @Model.EventName</h2>
    <a asp-controller="OrganiserEvents" asp-action="Index" class="btn btn-outline-secondary">Back to events</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.CanCapture)
{
    <div class="alert alert-info">
        This event takes place on @Model.EventDate.ToString("dd MMM yyyy HH:mm").
        Results can only be captured after the event has taken place.
    </div>
}

@if (Model.Rows.Count == 0)
{
    <p>Nobody has enrolled for this event yet, so there are no results to capture.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Finish time (hh:mm:ss)</th>
                    <th>Position</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.ParticipantName</td>
                        <td>@row.CategoryName</td>
                        @if (Model.CanCapture)
                        {
                            <form asp-action="Save" method="post">
                                <input type="hidden" name="eventId" value="@Model.EventId" />
                                <input type="hidden" name="enrolmentId" value="@row.EnrolmentId" />
                                <input type="hidden" name="resultId" value="@row.ResultId" />
                                <td>
                                    <input type="text" name="finishTime" value="@row.FinishTime" class="form-control form-control-sm" placeholder="00:45:30" />
                                </td>
                                <td>
                                    <input type="number" name="position" value="@row.Position" min="1" class="form-control form-control-sm" />
                                </td>
                                <td class="text-end">
                                    <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                </td>
                            </form>
                        }
                        else
                        {
                            <td>@(string.IsNullOrEmpty(row.FinishTime) ? "-" : row.FinishTime)</td>
                            <td>@(row.Position.HasValue ? row.Position.ToString() : "-")</td>
                            <td></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}