@model RaceDay.Web.Models.CategoriesPageViewModel
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Categories: @Model.EventName</h2>
    <a asp-controller="OrganiserEvents" asp-action="Index" class="btn btn-outline-secondary">Back to events</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Add" method="post" class="row g-2 mb-4">
    <input type="hidden" name="eventId" value="@Model.EventId" />
    <div class="col-md-6">
        <input type="text" name="name" class="form-control" placeholder="e.g. Under 20, 10km" maxlength="50" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Add category</button>
    </div>
</form>

@if (Model.Categories.Count == 0)
{
    <p>This event has no categories yet. Add one above.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Category</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Categories)
            {
                <tr>
                    <td>@c.Name</td>
                    <td class="text-end">
                        <form asp-action="Delete" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this category?');">
                            <input type="hidden" name="eventId" value="@Model.EventId" />
                            <input type="hidden" name="id" value="@c.CategoryId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}