@model RaceDay.Web.Models.EnrolmentsPageViewModel
@{
    ViewData["Title"] = "Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Enrolments: @Model.EventName</h2>
    <a asp-controller="OrganiserEvents" asp-action="Index" class="btn btn-outline-secondary">Back to events</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<p class="text-muted">Total enrolled: @Model.Enrolments.Count</p>

@if (Model.Enrolments.Count == 0)
{
    <p>Nobody has enrolled for this event yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Enrolled on</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td>@e.ParticipantName</td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolledOn.ToString("dd MMM yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}