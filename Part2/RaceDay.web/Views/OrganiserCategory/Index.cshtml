@model List<RaceDay.Web.Models.EventItem>
@{
    ViewData["Title"] = "My events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">My events</h2>
    <a asp-action="Create" class="btn btn-primary">Create new event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model.Count == 0)
{
    <p>You have not created any events yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Distance</th>
                    <th>Type</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Date.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@item.Location</td>
                        <td>@item.DistanceKm km</td>
                        <td>@item.EventType</td>
                        <td class="text-end">
                            <a asp-controller="OrganiserCategories" asp-action="Index" asp-route-eventId="@item.EventId" class="btn btn-sm btn-outline-secondary">Categories</a>
                            <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.EventId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}